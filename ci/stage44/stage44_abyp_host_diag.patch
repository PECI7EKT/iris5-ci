diff --git a/qcom/opensource/display-drivers/msm/iris_host_diag.h b/qcom/opensource/display-drivers/msm/iris_host_diag.h
new file mode 100644
index 0000000..ce049f2
--- /dev/null
+++ b/qcom/opensource/display-drivers/msm/iris_host_diag.h
@@ -0,0 +1,62 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _IRIS44_HOST_DIAG_H_
+#define _IRIS44_HOST_DIAG_H_
+#include <linux/types.h>
+
+/* Window correlation, not proof of causal ownership of another task's events. */
+enum iris44_event {
+	IRIS44_BEGIN = 1, IRIS44_END, IRIS44_ATTEMPT,
+	IRIS44_WAKE, IRIS44_PRECFG_SKIP,
+	IRIS44_WAIT_UNLOCK, IRIS44_WAIT_RETURN, IRIS44_PANEL_RELOCK,
+	IRIS44_RESET_CALL, IRIS44_RESET_LOW_DONE, IRIS44_RESET_DONE,
+	IRIS44_DPHY_POLL, IRIS44_DPHY_DONE,
+	IRIS44_SYS5_BEGIN, IRIS44_SYS5_END, IRIS44_GPIO_POLL,
+	IRIS44_DUMP_IN, IRIS44_DUMP_OUT,
+	IRIS44_CLK_REQ_IN = 128, IRIS44_CLK_REQ_OUT,
+	IRIS44_HOST_CFG_IN, IRIS44_HOST_CFG_OUT, IRIS44_HOST_PLL_OUT,
+	IRIS44_PHY_CFG_IN, IRIS44_PHY_CFG_OUT,
+	IRIS44_PLL_CFG_IN, IRIS44_PLL_CFG_OUT,
+	IRIS44_ULPS_IN, IRIS44_ULPS_OUT,
+	IRIS44_HS_ENABLE,
+};
+
+struct iris44_record {
+	u64 op, ns;
+	u32 seq, attempt, event, dropped, overlap, suppressed;
+	int owner, pid;
+	const void *ctx;
+	s64 v0, v1, v2, v3, v4, v5;
+};
+
+/* Four protected clock-manager state bytes, no register accesses. */
+#define IRIS44_STATES(cc, cl, mc, ml) \
+	((u32)(cc) | ((u32)(cl) << 8) | ((u32)(mc) << 16) | ((u32)(ml) << 24))
+
+#if defined(CONFIG_PXLW_IRIS)
+u64 iris44_diag_begin(const void *ctx, int mode);
+void iris44_diag_end(u64 op, const void *ctx, int result);
+void iris44_diag_attempt(u32 attempt);
+void iris44_diag_dump(bool active);
+void iris44_diag(u32 event, const void *ctx,
+	s64 v0, s64 v1, s64 v2, s64 v3, s64 v4, s64 v5);
+#else
+static inline u64 iris44_diag_begin(const void *ctx, int mode)
+{ (void)ctx; (void)mode; return 0; }
+static inline void iris44_diag_end(u64 op, const void *ctx, int result)
+{ (void)op; (void)ctx; (void)result; }
+static inline void iris44_diag_attempt(u32 attempt) { (void)attempt; }
+static inline void iris44_diag_dump(bool active) { (void)active; }
+static inline void iris44_diag(u32 event, const void *ctx,
+	s64 v0, s64 v1, s64 v2, s64 v3, s64 v4, s64 v5)
+{
+	(void)event; (void)ctx; (void)v0; (void)v1; (void)v2;
+	(void)v3; (void)v4; (void)v5;
+}
+#endif
+
+/* Original ignored callback result stays ignored, even when diagnostics are OFF. */
+static inline void iris44_diag_rc(u32 event, const void *ctx, int result)
+{
+	iris44_diag(event, ctx, result, 0, 0, 0, 0, 0);
+}
+#endif
