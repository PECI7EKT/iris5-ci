+/* Stage44: no printk, allocations, MMIO or hardware control in this observer. */
+static bool iris44_host_diag;
+module_param_named(iris44_host_diag, iris44_host_diag, bool, 0600);
+MODULE_PARM_DESC(iris44_host_diag, "Stage44 bounded ABYP host trace (default OFF)");
+
+#define IRIS44_WINDOW_NS (8ULL * NSEC_PER_SEC)
+static DEFINE_SPINLOCK(iris44_diag_lock);
+static struct {
+	u64 next_op, op, start_ns, rate_ns;
+	int owner;
+	u32 attempt, seq, major_used, host_used;
+	u32 major_dropped, host_dropped, overlap, suppressed;
+	u32 starts_rate, major_rate, host_rate;
+	bool active, dump;
+} iris44_state;
+
+static void iris44_rate_locked(u64 now)
+{
+	if (now - iris44_state.rate_ns >= NSEC_PER_SEC) {
+		iris44_state.rate_ns = now;
+		iris44_state.starts_rate = 0;
+		iris44_state.major_rate = 0;
+		iris44_state.host_rate = 0;
+	}
+}
+
+static void iris44_record_locked(struct iris44_record *r, u64 now,
+	u32 event, const void *ctx, s64 v0, s64 v1, s64 v2,
+	s64 v3, s64 v4, s64 v5)
+{
+	*r = (struct iris44_record) {
+		.op = iris44_state.op, .ns = now, .seq = ++iris44_state.seq,
+		.attempt = iris44_state.attempt, .event = event,
+		.owner = iris44_state.owner, .pid = task_pid_nr(current),
+		.dropped = iris44_state.major_dropped + iris44_state.host_dropped,
+		.overlap = iris44_state.overlap, .suppressed = iris44_state.suppressed, .ctx = ctx,
+		.v0 = v0, .v1 = v1, .v2 = v2, .v3 = v3, .v4 = v4, .v5 = v5,
+	};
+}
+
+u64 iris44_diag_begin(const void *ctx, int mode)
+{
+	struct iris44_record r;
+	unsigned long flags;
+	u64 now;
+
+	if (!READ_ONCE(iris44_host_diag) || !trace_iris44_host_enabled() ||
+	    in_interrupt() || irqs_disabled())
+		return 0;
+	spin_lock_irqsave(&iris44_diag_lock, flags);
+	now = ktime_get_ns();
+	iris44_rate_locked(now);
+	if (iris44_state.active) {
+		iris44_state.overlap++;
+		spin_unlock_irqrestore(&iris44_diag_lock, flags);
+		return 0;
+	}
+	if (iris44_state.starts_rate >= 2) {
+		spin_unlock_irqrestore(&iris44_diag_lock, flags);
+		return 0;
+	}
+	iris44_state.starts_rate++;
+	iris44_state.op = ++iris44_state.next_op;
+	iris44_state.owner = task_pid_nr(current);
+	iris44_state.start_ns = now;
+	iris44_state.attempt = 0;
+	iris44_state.seq = 0;
+	iris44_state.major_used = 0;
+	iris44_state.host_used = 0;
+	iris44_state.major_dropped = 0;
+	iris44_state.host_dropped = 0;
+	iris44_state.overlap = 0;
+	iris44_state.suppressed = 0;
+	iris44_state.dump = false;
+	iris44_state.active = true;
+	iris44_record_locked(&r, now, IRIS44_BEGIN, ctx, mode, 0, 0, 0, 0, 0);
+	spin_unlock_irqrestore(&iris44_diag_lock, flags);
+	trace_iris44_host(&r);
+	return r.op;
+}
+
+void iris44_diag(u32 event, const void *ctx,
+	s64 v0, s64 v1, s64 v2, s64 v3, s64 v4, s64 v5)
+{
+	struct iris44_record r;
+	unsigned long flags;
+	u64 now;
+	bool host = event >= IRIS44_CLK_REQ_IN;
+
+	if (!READ_ONCE(iris44_host_diag) || !trace_iris44_host_enabled() ||
+	    in_interrupt() || irqs_disabled())
+		return;
+	spin_lock_irqsave(&iris44_diag_lock, flags);
+	if (!iris44_state.active) {
+		spin_unlock_irqrestore(&iris44_diag_lock, flags);
+		return;
+	}
+	/* Do not let the owner's 80-register failure dump consume the host budget.
+	 * Other tasks remain observable; standard CCF trace can cover the dump itself.
+	 */
+	if (host && iris44_state.dump && iris44_state.owner == task_pid_nr(current)) {
+		iris44_state.suppressed++;
+		spin_unlock_irqrestore(&iris44_diag_lock, flags);
+		return;
+	}
+	now = ktime_get_ns();
+	iris44_rate_locked(now);
+	if (now - iris44_state.start_ns >= IRIS44_WINDOW_NS ||
+	    (host && (iris44_state.host_rate >= 128 || iris44_state.host_used >= 256)) ||
+	    (!host && (iris44_state.major_rate >= 128 || iris44_state.major_used >= 128))) {
+		if (host)
+			iris44_state.host_dropped++;
+		else
+			iris44_state.major_dropped++;
+		iris44_state.seq++;
+		spin_unlock_irqrestore(&iris44_diag_lock, flags);
+		return;
+	}
+	if (host) {
+		iris44_state.host_rate++;
+		iris44_state.host_used++;
+	} else {
+		iris44_state.major_rate++;
+		iris44_state.major_used++;
+	}
+	iris44_record_locked(&r, now, event, ctx, v0, v1, v2, v3, v4, v5);
+	spin_unlock_irqrestore(&iris44_diag_lock, flags);
+	trace_iris44_host(&r);
+}
+
+void iris44_diag_attempt(u32 attempt)
+{
+	unsigned long flags;
+	bool owner = false;
+
+	if (!READ_ONCE(iris44_host_diag) || in_interrupt() || irqs_disabled())
+		return;
+	spin_lock_irqsave(&iris44_diag_lock, flags);
+	if (iris44_state.active && iris44_state.owner == task_pid_nr(current)) {
+		iris44_state.attempt = attempt;
+		owner = true;
+	}
+	spin_unlock_irqrestore(&iris44_diag_lock, flags);
+	if (owner)
+		iris44_diag(IRIS44_ATTEMPT, NULL, attempt, 0, 0, 0, 0, 0);
+}
+
+void iris44_diag_dump(bool active)
+{
+	unsigned long flags;
+	bool owner = false;
+
+	if (!READ_ONCE(iris44_host_diag) || in_interrupt() || irqs_disabled())
+		return;
+	spin_lock_irqsave(&iris44_diag_lock, flags);
+	if (iris44_state.active && iris44_state.owner == task_pid_nr(current)) {
+		iris44_state.dump = active;
+		owner = true;
+	}
+	spin_unlock_irqrestore(&iris44_diag_lock, flags);
+	if (owner)
+		iris44_diag(active ? IRIS44_DUMP_IN : IRIS44_DUMP_OUT, NULL, 0, 0, 0, 0, 0, 0);
+}
+
+void iris44_diag_end(u64 op, const void *ctx, int result)
+{
+	struct iris44_record r;
+	unsigned long flags;
+	u64 now;
+
+	if (!op || in_interrupt() || irqs_disabled())
+		return;
+	spin_lock_irqsave(&iris44_diag_lock, flags);
+	if (!iris44_state.active || iris44_state.op != op ||
+	    iris44_state.owner != task_pid_nr(current)) {
+		spin_unlock_irqrestore(&iris44_diag_lock, flags);
+		return;
+	}
+	now = ktime_get_ns();
+	iris44_record_locked(&r, now, IRIS44_END, ctx, result,
+		iris44_state.major_dropped, iris44_state.host_dropped,
+		now - iris44_state.start_ns >= IRIS44_WINDOW_NS,
+		iris44_state.major_used, iris44_state.host_used);
+	iris44_state.active = false;
+	spin_unlock_irqrestore(&iris44_diag_lock, flags);
+	if (READ_ONCE(iris44_host_diag) && trace_iris44_host_enabled())
+		trace_iris44_host(&r);
+}
