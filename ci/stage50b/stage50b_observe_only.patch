+
+/* Stage50B observer: diagnostic state only; no device reads or driver locks. */
+#define IRIS50B_WINDOW_NS (30ULL * NSEC_PER_SEC)
+static bool iris50b_observe;
+static struct {
+	u64 generation, start_ns, rate_ns, seen_op, seq;
+	u32 major_rate, detail_rate, major_used, detail_used;
+	u32 dropped, suppressed;
+} iris50b_state;
+static atomic_t iris50b_irq_skipped = ATOMIC_INIT(0);
+static atomic_t iris50b_expired_skipped = ATOMIC_INIT(0);
+
+static int iris50b_set(const char *value, const struct kernel_param *kp)
+{
+	struct kernel_param temporary = *kp;
+	unsigned long flags;
+	bool requested = false;
+	int rc;
+
+	temporary.arg = &requested;
+	rc = param_ops_bool.set(value, &temporary);
+	if (rc)
+		return rc;
+	spin_lock_irqsave(&iris44_diag_lock, flags);
+	if (requested && READ_ONCE(iris50b_observe)) {
+		spin_unlock_irqrestore(&iris44_diag_lock, flags);
+		return -EBUSY;
+	}
+	if (requested) {
+		u64 generation = iris50b_state.generation + 1;
+		u64 now = ktime_get_ns();
+
+		memset(&iris50b_state, 0, sizeof(iris50b_state));
+		iris50b_state.generation = generation;
+		iris50b_state.start_ns = now;
+		iris50b_state.rate_ns = now;
+		atomic_set(&iris50b_irq_skipped, 0);
+		atomic_set(&iris50b_expired_skipped, 0);
+	}
+	WRITE_ONCE(iris50b_observe, requested);
+	spin_unlock_irqrestore(&iris44_diag_lock, flags);
+	return 0;
+}
+
+static int iris50b_get_bool(char *buffer, const struct kernel_param *kp)
+{
+	return param_ops_bool.get(buffer, kp);
+}
+
+static int iris50b_get_stats(char *buffer, const struct kernel_param *kp)
+{
+	unsigned long flags;
+	u64 generation, elapsed_ms, seq, seen_op;
+	u32 major, detail, dropped, suppressed;
+	bool enabled, finished;
+
+	(void)kp;
+	spin_lock_irqsave(&iris44_diag_lock, flags);
+	generation = iris50b_state.generation;
+	elapsed_ms = generation ? (ktime_get_ns() - iris50b_state.start_ns) / 1000000 : 0;
+	seq = iris50b_state.seq;
+	seen_op = iris50b_state.seen_op;
+	major = iris50b_state.major_used;
+	detail = iris50b_state.detail_used;
+	dropped = iris50b_state.dropped;
+	suppressed = iris50b_state.suppressed;
+	enabled = READ_ONCE(iris50b_observe);
+	finished = seen_op && (!iris44_state.active || iris44_state.op != seen_op);
+	spin_unlock_irqrestore(&iris44_diag_lock, flags);
+	return scnprintf(buffer, 512,
+		"enabled=%u gen=%llu elapsed_ms=%llu seq=%llu op=%llu major=%u detail=%u dropped=%u suppressed=%u irq_skipped=%d expired_skipped=%d finished=%u expired=%u\n",
+		enabled, (unsigned long long)generation, (unsigned long long)elapsed_ms,
+		(unsigned long long)seq, (unsigned long long)seen_op,
+		major, detail, dropped, suppressed,
+		atomic_read(&iris50b_irq_skipped), atomic_read(&iris50b_expired_skipped),
+		finished, elapsed_ms >= 30000);
+}
+
+static const struct kernel_param_ops iris50b_observe_ops = {
+	.set = iris50b_set,
+	.get = iris50b_get_bool,
+};
+static const struct kernel_param_ops iris50b_stats_ops = {
+	.get = iris50b_get_stats,
+};
+module_param_cb(iris50b_observe, &iris50b_observe_ops, &iris50b_observe, 0600);
+MODULE_PARM_DESC(iris50b_observe, "Stage50B bounded observation, default OFF; N then Y arms 30 seconds");
+module_param_cb(iris50b_stats, &iris50b_stats_ops, NULL, 0400);
+MODULE_PARM_DESC(iris50b_stats, "Stage50B software observer counters; read only");
+
+void iris50b_diag(u32 event, const void *ctx,
+	s64 v0, s64 v1, s64 v2, s64 v3, s64 v4, s64 v5)
+{
+	struct iris50b_record r;
+	unsigned long flags;
+	u64 generation, now;
+	bool detail = event >= IRIS50B_ULPS_BACKEND;
+
+	if (!READ_ONCE(iris50b_observe) || !trace_iris50b_observe_enabled())
+		return;
+	if (in_interrupt() || irqs_disabled()) {
+		atomic_inc(&iris50b_irq_skipped);
+		return;
+	}
+	generation = READ_ONCE(iris50b_state.generation);
+	now = ktime_get_ns();
+	if (now - READ_ONCE(iris50b_state.start_ns) >= IRIS50B_WINDOW_NS) {
+		atomic_inc(&iris50b_expired_skipped);
+		return;
+	}
+	spin_lock_irqsave(&iris44_diag_lock, flags);
+	if (!READ_ONCE(iris50b_observe) || generation != iris50b_state.generation ||
+	    (iris50b_state.seen_op &&
+	     (!iris44_state.active || iris44_state.op != iris50b_state.seen_op))) {
+		spin_unlock_irqrestore(&iris44_diag_lock, flags);
+		return;
+	}
+	now = ktime_get_ns();
+	if (now - iris50b_state.start_ns >= IRIS50B_WINDOW_NS) {
+		atomic_inc(&iris50b_expired_skipped);
+		spin_unlock_irqrestore(&iris44_diag_lock, flags);
+		return;
+	}
+	if (iris44_state.active && !iris50b_state.seen_op)
+		iris50b_state.seen_op = iris44_state.op;
+	if (iris44_state.active && iris44_state.dump &&
+	    iris44_state.owner == task_pid_nr(current)) {
+		iris50b_state.suppressed++;
+		spin_unlock_irqrestore(&iris44_diag_lock, flags);
+		return;
+	}
+	if (now - iris50b_state.rate_ns >= NSEC_PER_SEC) {
+		iris50b_state.rate_ns = now;
+		iris50b_state.major_rate = 0;
+		iris50b_state.detail_rate = 0;
+	}
+	iris50b_state.seq++;
+	if ((detail && (iris50b_state.detail_rate >= 128 || iris50b_state.detail_used >= 512)) ||
+	    (!detail && (iris50b_state.major_rate >= 64 || iris50b_state.major_used >= 128))) {
+		iris50b_state.dropped++;
+		spin_unlock_irqrestore(&iris44_diag_lock, flags);
+		return;
+	}
+	if (detail) {
+		iris50b_state.detail_rate++;
+		iris50b_state.detail_used++;
+	} else {
+		iris50b_state.major_rate++;
+		iris50b_state.major_used++;
+	}
+	r = (struct iris50b_record) {
+		.generation = generation, .ns = now, .seq = iris50b_state.seq,
+		.op = iris44_state.active ? iris44_state.op : 0,
+		.attempt = iris44_state.active ? iris44_state.attempt : 0,
+		.owner = iris44_state.active ? iris44_state.owner : 0,
+		.pid = task_pid_nr(current), .event = event,
+		.dropped = iris50b_state.dropped, .suppressed = iris50b_state.suppressed,
+		.ctx = ctx, .v0 = v0, .v1 = v1, .v2 = v2,
+		.v3 = v3, .v4 = v4, .v5 = v5,
+	};
+	spin_unlock_irqrestore(&iris44_diag_lock, flags);
+	trace_iris50b_observe(&r);
+}
+/* End Stage50B observer. */
 
