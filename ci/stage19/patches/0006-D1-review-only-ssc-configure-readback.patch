+/* Review-only diagnostic: called in the existing PLL register-access context. */
+static void dsi_pll_ssc_diag(struct dsi_pll_resource *rsc, bool commit,
+		const char *phase)
+{
+	u32 control = DSI_PLL_REG_R(rsc->pll_base, PLL_SSC_CONTROL);
+
+	DSI_PLL_INFO(rsc,
+		"SSC_DIAG phase=%s commit=%d configured=%d control=0x%08x enabled=%d\n",
+		phase, commit, rsc->ssc_en, control, !!(control & SSC_EN));
+}
